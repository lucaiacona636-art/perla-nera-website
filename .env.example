# Email — necessaria per ricevere davvero le richieste dei form (Configuratore,
# Richiedi un progetto, Assistenza, Contatti) via email, invece che solo nei log
# del server. Senza queste variabili l'endpoint funziona comunque e non perde
# nessuna richiesta (resta loggata), ma non arriva nessuna email allo studio.
#
# 1. Crea un account gratuito su https://resend.com
# 2. Verifica il dominio perlanera.it in Resend (aggiungendo i record DNS che
#    Resend indica nel pannello — TXT/CNAME per SPF/DKIM)
# 3. Crea una API key in Resend e incollala qui sotto
RESEND_API_KEY=

# Mittente delle notifiche — deve appartenere al dominio verificato in Resend.
# Finché il dominio non è verificato, lascia questa riga vuota: il sistema
# userà automaticamente il mittente di test onboarding@resend.dev (che però
# Resend consegna solo alla casella email con cui vi siete registrati, non a
# terzi — utile solo per verificare che l'invio funzioni, non per la produzione).
RESEND_FROM_EMAIL="Perla Nera <notifiche@perlanera.it>"

# Dove arrivano le notifiche delle nuove richieste. Default: info@perlanera.it
LEAD_NOTIFICATION_EMAIL=info@perlanera.it

# Opzionale — se in futuro volete anche inoltrare ogni richiesta a uno
# strumento esterno (Zapier, Make, Google Sheets, un CRM...), incollate qui
# l'URL del webhook fornito da quello strumento. Lasciate vuoto per ignorare.
LEAD_WEBHOOK_URL=

# Analytics — opzionali. Senza queste variabili il sito funziona comunque:
# nessuno script di tracciamento viene caricato, nessun ID falso viene
# inserito. Aggiungerle attiva Google Tag Manager (da cui si collegano poi
# GA4 e Meta Pixel lato GTM, senza altre modifiche al codice) e la verifica
# proprietà di Google Search Console.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
